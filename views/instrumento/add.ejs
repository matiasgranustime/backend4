
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Adicionar Instrumento</title>
</head>
<body>

    <h2>Adicionar Instrumento</h2>

    <form method="post" action="/instrumento/add/ok">

        Nome:
        <input type="text" name="nome" required>
        <br><br>

        Fabricante:
        <input type="text" name="fabricante">
        <br><br>

        Preço:
        <input type="number" name="preco" step="0.01">
        <br><br>

        Tipo:
        <input type="text" name="tipo">
        <br><br>

        <input type="submit" value="Salvar">

    </form>

    <br>

    <a href="/instrumento/lst">Voltar para lista</a>

</body>
</html>
